{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/prototype",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/prototype/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/mobile",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/mobile/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/site",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/site/(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/bcfg/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=2592000"
        }
      ]
    }
  ]
}
